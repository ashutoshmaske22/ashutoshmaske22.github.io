---
// Small line icons for the skill cards. Drawn with currentColor so they follow the theme.
interface Props { name: 'delivery' | 'infrastructure' | 'data' | 'ai' }
const { name } = Astro.props;
---
<svg class="icon" viewBox="0 0 40 40" width="40" height="40" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
  {name === 'delivery' && (
    <>
      <circle cx="10" cy="10" r="3.5" />
      <circle cx="10" cy="30" r="3.5" />
      <circle cx="30" cy="20" r="3.5" />
      <path d="M10 13.5v13" />
      <path d="M10 18c0 2 2 2 6 2h10.5" />
      <path d="M23 16.5l3.5 3.5-3.5 3.5" />
    </>
  )}
  {name === 'infrastructure' && (
    <>
      <rect x="7" y="7" width="26" height="8" rx="2" />
      <rect x="7" y="17" width="26" height="8" rx="2" />
      <rect x="7" y="27" width="26" height="6" rx="2" />
      <path d="M12 11h.01M12 21h.01M12 30h.01" stroke-width="2.6" />
      <path d="M18 11h10M18 21h10" opacity=".5" />
    </>
  )}
  {name === 'data' && (
    <>
      <ellipse cx="20" cy="10" rx="11" ry="4" />
      <path d="M9 10v20c0 2.2 4.9 4 11 4s11-1.8 11-4V10" />
      <path d="M9 20c0 2.2 4.9 4 11 4s11-1.8 11-4" />
      <path d="M27 28l2 2 4-4" stroke="var(--ok)" />
    </>
  )}
  {name === 'ai' && (
    <>
      <rect x="11" y="11" width="18" height="18" rx="3" />
      <path d="M16 7v4M24 7v4M16 29v4M24 29v4M7 16h4M7 24h4M29 16h4M29 24h4" />
      <circle cx="16.5" cy="17" r="1.6" />
      <circle cx="23.5" cy="17" r="1.6" />
      <circle cx="20" cy="23.5" r="1.6" />
      <path d="M17.6 18.2l1.6 4.1M22.4 18.2l-1.6 4.1M18.1 17h3.8" opacity=".6" />
    </>
  )}
</svg>

<style>
  .icon { color: var(--accent); display: block; }
</style>
